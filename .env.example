# ============================================================
# 一键部署配置模板
# 用法：cp .env.example .env 后按需修改；
#      直接运行 ./deploy.sh 会自动创建 .env 并生成随机密钥。
# 说明：.env 被 .dockerignore 排除，不会打进镜像。
# ============================================================

# 应用映射到宿主机的端口（浏览器访问用）
APP_PORT=34369

# MySQL 映射到宿主机的端口（仅为方便本地调试，生产可改为 127.0.0.1:3306 对应格式）
MYSQL_PORT=3306
MYSQL_DATABASE=shop_admin
# 部署脚本会自动替换为随机值；请务必修改，不要用默认 root
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_16_HEX

# JWT 签名密钥，生产必须 >= 32 字符随机值
# 部署脚本会自动生成；手动修改后需重启应用，旧令牌会失效
JWT_SECRET=CHANGE_ME_RANDOM_32_HEX
JWT_EXPIRATION_MINUTES=120

# 允许的前端来源，逗号分隔、不要加空格
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 部署时等待容器健康检查的最长秒数
HEALTH_TIMEOUT=180
